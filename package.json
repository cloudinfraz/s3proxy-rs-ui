{
  "name": "s3proxy-rs-ui",
  "private": true,
  "version": "0.6.3",
  "description": "Standalone administration UI for s3proxy-rs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudinfraz/s3proxy-rs-ui.git"
  },
  "bugs": {
    "url": "https://github.com/cloudinfraz/s3proxy-rs-ui/issues"
  },
  "homepage": "https://github.com/cloudinfraz/s3proxy-rs-ui#readme",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript contracts/admin-openapi.json -o src/api/schema.d.ts",
    "build": "npm run generate:api && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:deploy": "node --test scripts/deploy/*.test.mjs && scripts/deploy/render-ui-manifest.test.sh",
    "test:release": "node --test scripts/release/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/themes": "3.3.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
