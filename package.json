{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../src/admin/openapi.json -o src/api/schema.d.ts",
    "build": "npm run generate:api && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/themes": "3.3.0",
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.71.0",
    "typescript": "5.9.3",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "2.1.3",
    "js-yaml": "4.3.0"
  }
}
